def omega(gyr):
    return math.sqrt(sum(axis**2 for axis in gyr));

def do_gyr_integrate():
    # [time, omega, [gyr], [rotmat]]
    # rotmat rotates a vector in that timepoint's device coordinates into the initial timepoint's device coordinates
    limit = len(data['gyr']);
    output = list();
    time_start = data['gyr'][0][0] / 1e9;
    output.append([0, omega(data['gyr'][0][2:]), data['gyr'][0][2:], [[1, 0, 0], [0, 1, 0], [0, 0, 1]]]);
    for i in range(1, limit):
        cur = [data['gyr'][i][0] / 1e9 - time_start, data['gyr'][i][2:]];
        prev = [data['gyr'][i - 1][0] / 1e9 - time_start, data['gyr'][i - 1][2:]];
        rot_vec = trapezoid(prev, cur);
        theta = omega(rot_vec);
        axis = [a / theta for a in rot_vec];
        cos_ = math.cos(theta);
        cos_2 = 1 - cos_;
        sin_ = math.sin(theta);
        rot_cur_to_prev = np.array([[cos_2 * axis[0]**2 + cos_, cos_2 * axis[0] * axis[1] - sin_ * axis[2], cos_2 * axis[0] * axis[2] + sin_ * axis[1]],
                  [cos_2 * axis[1] * axis[0] + sin_ * axis[2], cos_2 * axis[1]**2 + cos_, cos_2 * axis[1] * axis[2] - sin_ * axis[0]],
                  [cos_2 * axis[2] * axis[0] - sin_ * axis[1], cos_2 * axis[2] * axis[1] + sin_ * axis[0], cos_2 * axis[2]**2 + cos_]]);
        rot_prev_to_orig = np.array(output[i - 1][3]);
        rot_cur_to_orig = np.matmul(rot_prev_to_orig, rot_cur_to_prev).tolist();
        # putting in omega for consistency with previous right-rule outputs. I don't think it really matters/is useful;
        # I don't think I've looked at it at all.
        output.append([cur[0], omega(data['gyr'][i][2:]), data['gyr'][i][2:], rot_cur_to_orig]);
    return output;
def rotmat_to_axis_angle(R):
    theta = math.acos((sum(R[i][i] for i in range(3)) - 1) / 2)
    omega = [R[2][1] - R[1][2], R[0][2] - R[2][0], R[1][0] - R[0][1]];
    factor = 1 / (2 * math.sin(theta))
    omega = [factor * omega[i] for i in range(3)]
    return (theta, omega)
def rnd(x):
    return (round(x[0], 3), [round(x[1][i], 6) for i in range(3)])

gyr_integrate = do_gyr_integrate();
print(json.dumps(gyr_integrate));
print("rotation at point 1000: {}".format(rnd(rotmat_to_axis_angle(gyr_integrate[1000][3]))), file=sys.stderr);
print("rotation at final point ({}): {}".format(len(gyr_integrate) - 1, rnd(rotmat_to_axis_angle(gyr_integrate[-1][3]))), file=sys.stderr);
