        delta_x = trapezoid([output[i - 1][0], output[i - 1][5]], [cur[0], v]);
        x = [output[i - 1][6][j] + delta_x[j] for j in range(3)];
        output.append([cur[0], omega(data['gyr'][i][2:]), data['gyr'][i][2:], rot_cur_to_orig.tolist(), lac, v, x]);
    return (output, dbg_out);


