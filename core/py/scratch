def denoise(sensor, ratio):
    output = list();
    for i in range(math.ceil(len(data[sensor]) / ratio)):
        values = [a[2:] for a in data[sensor][i*ratio:(i+1)*ratio]];
        mean = [sum(values[i][j] for i in range(len(values))) / len(values) for j in range(3)];
        output.append(mean);
    return output;

def findmax_2(vectors):
    m = max(vectors[0]);
    for vec in vectors:
        m = max(max(vec), m);
    return m;
def findmaxdiff_2(vectors):
    m = max([abs(b - a) for a,b in zip(vectors[0], vectors[1])]);
    for i in range(2, len(vectors)):
        m = max(max([abs(b - a) for a,b in zip(vectors[i-1], vectors[i])]), m);
    return m;

